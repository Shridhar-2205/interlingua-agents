# Copy to compression/.env and fill in. compression/.env is gitignored (see ../.gitignore).
# The LLM version (llm_compress.py) reads either an Azure OpenAI or an OpenAI key.
# Values already present in your shell environment take precedence.

# --- Option A: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Option B: OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
